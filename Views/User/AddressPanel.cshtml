@model FoodOrderWeb.Models.ViewModel.UserViewModel
@{
    Layout = "~/Views/Shared/_Userlayout.cshtml";
    ViewData["Title"] = "Địa chỉ";
}

<partial name="_ValidationScriptsPartial" />

<style>
    /* 🌿 Tông màu gradient */
    :root {
        --gradient-main: linear-gradient(135deg, #84fab0, #8fd3f4);
        --gradient-green: linear-gradient(90deg, #4ade80, #16a34a);
        --gradient-hover: linear-gradient(90deg, #22c55e, #a3e635);
        --text-gradient: linear-gradient(90deg, #4ade80, #86efac);
    }

    /* 🌿 Nút gradient */
    .btn-gradient {
        background: var(--gradient-green);
        color: #fff;
        border: none;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.4s ease;
        box-shadow: 0 4px 12px rgba(74, 222, 128, 0.4);
    }

        .btn-gradient:hover {
            background: var(--gradient-hover);
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 6px 18px rgba(34, 197, 94, 0.5);
        }

    /* 🌿 Text gradient */
    .text-gradient {
        background: var(--text-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }

    /* 🌿 Overlay nền mờ */
    #overlay {
        position: fixed;
        inset: 0;
        background: rgba(20, 20, 20, 0.45);
        backdrop-filter: blur(5px);
        z-index: 99;
        display: none;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

        #overlay.show {
            display: block;
            opacity: 1;
        }

    /* 🌿 Modal form */
    #addAddressForm {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 440px;
        transform: translate(-50%, -50%) scale(0.9);
        background: #ffffff;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        z-index: 100;
        display: none;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.3, 1);
        border-top: 5px solid transparent;
        background-image: linear-gradient(white, white), var(--gradient-main);
        background-origin: border-box;
        background-clip: padding-box, border-box;
    }

        #addAddressForm.show {
            display: block;
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }

        #addAddressForm h5 {
            background: var(--text-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            text-align: center;
            margin-bottom: 25px;
        }

    input.form-control:focus {
        border-color: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.5);
    }

    #btnCancelForm {
        background: linear-gradient(90deg, #f87171, #ef4444);
        color: #fff;
        border: none;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        #btnCancelForm:hover {
            background: linear-gradient(90deg, #dc2626, #f87171);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4);
        }

    .address-item {
        transition: all 0.3s ease;
        border-left: 5px solid transparent;
        border-radius: 14px;
        background: #ffffff;
    }

        .address-item:hover {
            border-left: 5px solid #4ade80;
            box-shadow: 0 8px 20px rgba(74, 222, 128, 0.25);
            transform: translateY(-3px);
        }
</style>

<div class="container mt-4">
    <h4 class="mb-3 fw-bold text-gradient">Địa chỉ</h4>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <button id="btnShowForm" class="btn btn-gradient mb-3 fw-bold">+ Thêm địa chỉ mới</button>

    @if (Model.Addresses != null && Model.Addresses.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var addr in Model.Addresses)
            {
                <li class="list-group-item mb-2 shadow-sm address-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@(addr.Label ?? "Địa chỉ")</strong> - @addr.Street<br />
                            @addr.District, @addr.City
                            @if (addr.IsDefault)
                            {
                                <span class="badge bg-success ms-2">Mặc định</span>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            @if (!addr.IsDefault)
                            {
                                <form asp-action="SetDefaultAddress" method="post" style="display:inline;">
                                    <input type="hidden" name="addressId" value="@addr.AddressId" />
                                    <button type="submit" class="btn btn-gradient btn-sm">Đặt mặc định</button>
                                </form>
                            }
                            <form asp-action="DeleteAddress" method="post" style="display:inline;">
                                <input type="hidden" name="addressId" value="@addr.AddressId" />
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p>Chưa có địa chỉ nào.</p>
    }
</div>

<!-- 🌿 Overlay + Form -->
<div id="overlay">
    <div id="addAddressForm">
        <h5>Thêm địa chỉ mới</h5>

        <form asp-action="AddAddress" asp-controller="User" method="post">
            <div class="mb-3">
                <label asp-for="NewAddress.Label" class="form-label">Nhãn</label>
                <input asp-for="NewAddress.Label" class="form-control" />
                <span asp-validation-for="NewAddress.Label" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewAddress.Street" class="form-label">Đường</label>
                <input asp-for="NewAddress.Street" class="form-control" />
                <span asp-validation-for="NewAddress.Street" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="NewAddress.District" class="form-label">Huyện</label>
                    <input asp-for="NewAddress.District" class="form-control" />
                    <span asp-validation-for="NewAddress.District" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NewAddress.City" class="form-label">Thành phố/Tỉnh</label>
                    <input asp-for="NewAddress.City" class="form-control" />
                    <span asp-validation-for="NewAddress.City" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="NewAddress.IsDefault" class="form-check-input"/>
                <label asp-for="NewAddress.IsDefault" class="form-check-label"></label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-gradient px-4">Lưu</button>
                <button type="button" id="btnCancelForm" class="btn btn-secondary px-4">Hủy</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnShow = document.getElementById('btnShowForm');
        const form = document.getElementById('addAddressForm');
        const overlay = document.getElementById('overlay');
        const btnCancel = document.getElementById('btnCancelForm');

        function showForm() {
            overlay.style.display = 'block';
            form.style.display = 'block';
            requestAnimationFrame(() => {
                overlay.classList.add('show');
                form.classList.add('show');
            });
            btnShow.style.display = 'none';
        }

        function hideForm() {
            overlay.classList.remove('show');
            form.classList.remove('show');
            setTimeout(() => {
                overlay.style.display = 'none';
                form.style.display = 'none';
                btnShow.style.display = 'inline-block';
            }, 400);
        }

        if (btnShow) btnShow.addEventListener('click', showForm);

        if (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) hideForm();
            });
        }

        if (form) {
            form.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }

        if (btnCancel) btnCancel.addEventListener('click', hideForm);

        const hasErrors = @(!ViewData.ModelState.IsValid).ToString().ToLower() === "false" ? false : true;

        if (hasErrors) {
            overlay.style.display = 'block';
            form.style.display = 'block';
            requestAnimationFrame(() => {
                overlay.classList.add('show');
                form.classList.add('show');
            });
            btnShow.style.display = 'none';
        }
    });
</script>
